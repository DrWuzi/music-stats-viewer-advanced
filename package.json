    "next": "16.2.10",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.7", 
    "react-dom": "19.2.7",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
